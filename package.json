{
  "name": "@2gis/mapgl-directions",
  "version": "2.2.1",
  "description": "Driving directions plugin for Mapgl",
  "main": "dist/directions.js",
  "typings": "dist/types/index.d.ts",
  "scripts": {
    "build": "npm run build:assets && npm run build:docs && npm run build:js-demo && npm run build:typings",
    "build-for-npm": "npm run build:assets && npm run build:docs && npm run build:js-prod && npm run build:typings",
    "build:assets": "node build/assets",
    "build:js-prod": "webpack --env type=production",
    "build:js-demo": "webpack --env type=demo",
    "build:typings": "tsc -p tsconfig.module.json --declaration --emitDeclarationOnly",
    "build:docs": "node build/docs",
    "dev": "npm run build:assets && webpack serve --env type=development",
    "prettier": "prettier --check \"./**/*.{ts,tsx,js,json,html,css,md}\"",
    "prettier:write": "prettier --write \"./**/*.{ts,tsx,js,json,html,css,md}\"",
    "lint": "eslint \"src/**/*.{js,ts}\" \"demo/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" \"demo/**/*.{js,ts}\" \"test/**/*.{js,ts}\" --fix",
    "test:screenshots": "webpack --env type=test && TEST_SUITE=screenshots jest --forceExit --projects test/screenshots --colors",
    "test:screenshots:update": "webpack --env type=test && TEST_SUITE=screenshots jest --forceExit --projects test/screenshots --colors -u",
    "test:screenshots:watch": "webpack --env type=test && TEST_SUITE=screenshots jest --forceExit --watchAll --projects test/screenshots --colors",
    "test:screenshots:no-headless": "webpack --env type=test && NO_HEADLESS=true TEST_SUITE=screenshots jest --forceExit --projects test/screenshots --colors"
  },
  "license": "BSD-2-Clause",
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "@2gis/mapgl": "1.61.0",
    "@2gis/ts-docs-generator": "^0.1.0",
    "@types/jest": "^29.5.13",
    "@types/jest-image-snapshot": "^4.3.1",
    "@types/puppeteer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prettier": "^5.5.0",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-dev-server": "^11.0.0",
    "jest-image-snapshot": "^6.4.0",
    "prettier": "^3.6.1",
    "puppeteer": "^23.10.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.2.6",
    "typescript": "4.9.4",
    "webpack": "^5.69.0",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^5.0.0",
    "wellknown": "^0.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "volta": {
    "node": "20.19.3",
    "npm": "10.8.2"
  }
}
